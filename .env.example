# CareerForge Pro Environment Variables

# Flask Secret Key (for session management)
SECRET_KEY=your-secret-key-here-change-in-production

# Anthropic API Key (required for AI resume generation)
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Admin Secret (for accessing /api/emails endpoint)
ADMIN_SECRET=your-admin-secret-here

# NOWPayments API Key (optional, for real crypto payments)
# Get from: https://nowpayments.io
NOWPAYMENTS_API_KEY=your-nowpayments-api-key-here

# Database directory (optional, defaults to same directory as app.py)
DB_DIR=/path/to/db

# Flask Environment
FLASK_ENV=production